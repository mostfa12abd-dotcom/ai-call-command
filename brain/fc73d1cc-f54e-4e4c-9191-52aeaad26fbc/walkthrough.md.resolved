            {"id": "m3", "subject": "Weekly Newsletter: CS Dept", "sender": "newsletter@cs.udst.edu.qa",
             "sender_email": "newsletter@cs.udst.edu.qa", "received": "2026-03-20T08:00",
             "body_preview": "Upcoming seminars, scholarships, and faculty achievements.", "importance": "low", "is_read": True},
        ]
        return [e for e in emails if not (only_unread and e["is_read"])]

    @staticmethod
    def _mock_calendar() -> List[Dict]:
        logger.info("Returning demo calendar data")
        today = datetime.now().strftime("%Y-%m-%d")
        return [
            {"subject": "Department Meeting", "start": f"{today}T11:00", "end": f"{today}T12:00",
